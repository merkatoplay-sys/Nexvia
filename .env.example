# ===========================================
# NEXVIA - Configuration File
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env (Linux/Mac)
# copy .env.example .env (Windows)

# ===========================================
# DATABASE (Required)
# ===========================================
# PostgreSQL connection string
# Local: postgresql://postgres:password@localhost:5432/nexvia
# Railway: postgresql://postgres:xxx@xxx.railway.app:5432/railway
# Supabase: postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexvia

# ===========================================
# AUTHENTICATION (Required)
# ===========================================
# Secret key for JWT tokens - use a random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ===========================================
# SERVER (Optional)
# ===========================================
# Server port (default: 5000)
PORT=5000

# Environment: development or production
NODE_ENV=development
